{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bhava Derived Web Assets Manifest",
  "type": "object",
  "required": [
    "story_no",
    "package_manifest_sha256",
    "story_md_sha256",
    "generated_at",
    "assets"
  ],
  "properties": {
    "story_no": {"type": "string", "pattern": "^[0-9]{3}$"},
    "package_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "story_md_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "generated_at": {"type": "string"},
    "recommended_playback_rate": {"type": "number", "minimum": 0.7, "maximum": 1.25},
    "assets": {
      "type": "object",
      "required": [
        "reader.md",
        "reader.txt",
        "source_links.json",
        "reflections.json",
        "shlokas.json",
        "sync.json",
        "waveform.json"
      ],
      "additionalProperties": {
        "type": "object",
        "required": ["sha256", "bytes"],
        "properties": {
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 1}
        }
      }
    }
  },
  "additionalProperties": true
}
