{
	email {$ACME_EMAIL}
	admin off
}

(common_security) {
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "accelerometer=(), autoplay=(self), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		Strict-Transport-Security "max-age=86400"
	}

	# Public activity-sheet PDF only: allow same-origin iframe preview.
	# All other routes keep clickjacking DENY (including HTML and private APIs).
	@activity_pdf path_regexp activity_pdf ^/api/v1/stories/[0-9]{3}/assets/activity_sheet\.pdf$
	@not_activity_pdf not path_regexp activity_pdf ^/api/v1/stories/[0-9]{3}/assets/activity_sheet\.pdf$
	header @not_activity_pdf {
		X-Frame-Options "DENY"
	}
	header @activity_pdf {
		X-Frame-Options "SAMEORIGIN"
		Content-Security-Policy "frame-ancestors 'self'"
	}

	@immutable path /_next/static/* /brand/* /heroes/* /icons/* /collections/* /empty-states/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Split matchers instead of `or` — stock caddy:2.10-alpine does not register
	# http.matchers.or, and a recreate with this block crash-loops TLS (P1 outage).
	@private_paths path /studio* /dev* /api/studio* /api/v1/factory* /api/v1/scheduler* /api/v1/queue*
	@private_story path_regexp private_story ^/stories/0*(2[1-9]|[3-9][0-9]|[1-9][0-9]{2,})(/.*)?$
	respond @private_paths 404
	respond @private_story 404

	@mutation {
		path /api/*
		not method GET HEAD OPTIONS
	}
	respond @mutation 405
}

bhava.me {
	import common_security

	# Production-only defense-in-depth: private reader projections must never
	# reach the API for stories above the public HTML boundary (021+).
	# Staging keeps /api reader access for authenticated review of 021/022.
	@private_reader_api path_regexp private_reader_api ^/api/v1/stories/0*(2[1-9]|[3-9][0-9]|[1-9][0-9]{2,})/reader(\.txt)?$
	respond @private_reader_api 404

	handle /healthz {
		reverse_proxy api-production:8000
	}
	handle /readyz {
		reverse_proxy api-production:8000
	}
	handle /api/* {
		reverse_proxy api-production:8000
	}
	handle {
		reverse_proxy web-production:3000
	}

	log {
		output file /var/log/caddy/bhava-access.log {
			roll_size 10MiB
			roll_keep 7
			roll_keep_for 168h
		}
		format json
	}
}

www.bhava.me {
	redir https://bhava.me{uri} permanent
}

staging.bhava.me {
	import common_security
	basic_auth {
		{$STAGING_BASIC_AUTH_USER} {$STAGING_BASIC_AUTH_HASH}
	}
	header X-Robots-Tag "noindex, nofollow, noarchive"

	handle /healthz {
		reverse_proxy api-staging:8000
	}
	handle /readyz {
		reverse_proxy api-staging:8000
	}
	handle /api/* {
		reverse_proxy api-staging:8000
	}
	handle {
		reverse_proxy web-staging:3000
	}

	log {
		output file /var/log/caddy/bhava-staging-access.log {
			roll_size 10MiB
			roll_keep 5
			roll_keep_for 120h
		}
		format json
	}
}
