# syntax=docker/dockerfile:1.7
FROM node:24-bookworm-slim AS dependencies
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json
COPY packages/ui/package.json packages/ui/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY scripts/ensure_native_optionals.cjs scripts/ensure_native_optionals.cjs
COPY apps/web/scripts/copy-pdf-worker.cjs apps/web/scripts/copy-pdf-worker.cjs
RUN npm ci

FROM dependencies AS build
WORKDIR /app
COPY . .
ARG RELEASE_SHA=development
ARG BHAVA_WEB_VERSION=001-022-v1
ARG BHAVA_CONTENT_RELEASE=bhava-content-001-022-v1
ARG NEXT_PUBLIC_BHAVA_PUBLIC_STORY_MAX=22
ARG GOOGLE_SITE_VERIFICATION=
ARG BING_SITE_VERIFICATION=
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
ENV BHAVA_CANONICAL_ORIGIN=https://bhava.me
ENV NEXT_PUBLIC_BHAVA_GIT_SHA=${RELEASE_SHA}
ENV NEXT_PUBLIC_BHAVA_WEB_VERSION=${BHAVA_WEB_VERSION}
ENV NEXT_PUBLIC_BHAVA_CONTENT_RELEASE=${BHAVA_CONTENT_RELEASE}
ENV NEXT_PUBLIC_BHAVA_PUBLIC_STORY_MAX=${NEXT_PUBLIC_BHAVA_PUBLIC_STORY_MAX}
ENV GOOGLE_SITE_VERIFICATION=${GOOGLE_SITE_VERIFICATION}
ENV BING_SITE_VERIFICATION=${BING_SITE_VERIFICATION}
RUN npm run build:web

FROM node:24-bookworm-slim AS runtime
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
WORKDIR /app
RUN useradd --system --uid 10001 --create-home bhava
COPY --from=build --chown=bhava:bhava /app/apps/web/.next/standalone ./
COPY --from=build --chown=bhava:bhava /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=bhava:bhava /app/apps/web/public ./apps/web/public
USER 10001
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "apps/web/server.js"]
