{
  "name": "bhava-portal",
  "private": true,
  "version": "1.0.0",
  "description": "Bhāva devotional learning portal (local v1)",
  "workspaces": [
    "apps/web",
    "packages/ui",
    "packages/contracts"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @bhava/web",
    "build:web": "npm run build -w @bhava/web",
    "lint:web": "npm run lint -w @bhava/web",
    "typecheck:web": "npm run typecheck -w @bhava/web",
    "test:web": "npm run test -w @bhava/web",
    "test:e2e": "npm run test:e2e -w @bhava/web",
    "postinstall": "node scripts/ensure_native_optionals.cjs"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "optionalDependencies": {
    "@next/swc-win32-x64-msvc": "15.5.22",
    "@rollup/rollup-win32-x64-msvc": "4.62.2"
  },
  "dependencies": {
    "postcss": "8.5.24",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "sharp": "0.35.3"
  },
  "overrides": {
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "postcss": "8.5.24",
    "sharp": "0.35.3",
    "next": {
      "postcss": "8.5.24",
      "sharp": "0.35.3"
    }
  }
}
